# ---------------------------------------------------------------------------
# Free-tier environment template
# ---------------------------------------------------------------------------
# This file documents every value you need to bootstrap across Vercel
# (frontend env vars) and Koyeb (agents-web + chat-worker secrets).
#
# It is NOT loaded by anything automatically. Paste into the Vercel /
# Koyeb dashboards or feed to their CLIs.
# ---------------------------------------------------------------------------

# --- Image registry (Koyeb) -----------------------------------------------
GHCR_OWNER=<your-github-org-or-user>

# --- URLs (set after you know your Vercel + Koyeb subdomains) -------------
# Vercel hobby domain defaults to <project>.vercel.app
NEXT_PUBLIC_APP_URL=https://<project>.vercel.app
# Koyeb gives you <app>-<org>.koyeb.app — this is the agents-web URL
NEXT_PUBLIC_API_URL=https://<agents-web>-<org>.koyeb.app
NEXTAUTH_URL=https://<project>.vercel.app
# Agents-service reads CORS_ORIGINS to allow the Vercel origin
CORS_ORIGINS=https://<project>.vercel.app

# --- Auth / secrets -------------------------------------------------------
NEXTAUTH_SECRET=<openssl rand -hex 32>
JWT_SECRET=<openssl rand -hex 32>         # Vercel (frontend)
JWT_SECRET_KEY=<openssl rand -hex 32>     # Koyeb (agents-service)
SECRET_KEY=<openssl rand -hex 32>         # Koyeb (Flask)
JWT_EXPIRES_IN=7d

# --- Postgres — Neon (https://console.neon.tech) --------------------------
# Project → Connection Details → "Pooled connection" (port 5432, pgbouncer).
DATABASE_URL=postgresql://<user>:<pw>@<project>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# --- Redis — Upstash (https://console.upstash.com) ------------------------
REDIS_URL=rediss://default:<pw>@<region>-<name>.upstash.io:6379
REDIS_HOST=<region>-<name>.upstash.io     # Vercel (frontend reads host/port split)
REDIS_PORT=6379
REDIS_PASSWORD=<pw>

# --- RabbitMQ — CloudAMQP Little Lemur (https://www.cloudamqp.com) --------
RABBITMQ_URL=amqps://<user>:<pw>@<host>.cloudamqp.com/<vhost>

# --- Object storage — Cloudflare R2 (https://dash.cloudflare.com/?to=/:account/r2) ---
# R2 is S3-compatible. Create an R2 API token with read/write scope.
# Endpoint URL is the account-level one (not the bucket URL).
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=<r2-access-key>
AWS_SECRET_ACCESS_KEY=<r2-secret-key>
AWS_S3_BUCKET_NAME=portfolio-helper
AWS_S3_REGION=auto

# --- AI providers ---------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
EXA_API_KEY=
PINECONE_API_KEY=
COMPOSIO_API_KEY=

# --- Daytona (browser sandbox — required on 512 MB!) ---------------------
DAYTONA_API_KEY=
SANDBOX_ENABLED=true

# --- Stripe (optional) ---------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=
NEXT_PUBLIC_STRIPE_PRICE_ID_ENTERPRISE=

# --- Sentry ---------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Email — Resend (https://resend.com) ---------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=<resend-api-key>

# --- Frontend feature flags ---------------------------------------------
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_WEB3FORMS_KEY=

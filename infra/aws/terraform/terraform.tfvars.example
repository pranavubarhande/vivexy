aws_region   = "us-east-1"
project_name = "portfolio-helper"
environment  = "prod"

domain_name        = "example.com"
frontend_subdomain = "app"
api_subdomain      = "api"

ghcr_owner         = "your-github-org"
frontend_image_tag = "latest"
agents_image_tag   = "latest"

# Create manually: a Secrets Manager secret with JSON payload
# {"username": "<github-user>", "password": "<ghcr-pat>"} and paste its ARN here.
ghcr_credentials_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:portfolio-helper/ghcr-XXXXXX"

rds_instance_class       = "db.t4g.medium"
rds_allocated_storage_gb = 50
rds_read_replica_count   = 0

redis_node_type          = "cache.t4g.small"
redis_num_shards         = 1
redis_replicas_per_shard = 1

mq_instance_type = "mq.t3.micro"

# Map env var name -> Secrets Manager secret ARN. Bootstrap these manually
# once per environment. DATABASE_URL, REDIS_URL, and RABBITMQ_URL are managed
# by Terraform and do NOT need to be listed here.
app_secrets = {
  OPENAI_API_KEY    = "arn:aws:secretsmanager:us-east-1:123456789012:secret:portfolio-helper/openai-XXXXXX"
  ANTHROPIC_API_KEY = "arn:aws:secretsmanager:us-east-1:123456789012:secret:portfolio-helper/anthropic-XXXXXX"
  GOOGLE_AI_API_KEY = "arn:aws:secretsmanager:us-east-1:123456789012:secret:portfolio-helper/google-ai-XXXXXX"
  GROQ_API_KEY      = "arn:aws:secretsmanager:us-east-1:123456789012:secret:portfolio-helper/groq-XXXXXX"
  EXA_API_KEY       = "arn:aws:secretsmanager:us-east-1:123456789012:secret:portfolio-helper/exa-XXXXXX"
  PINECONE_API_KEY  = "arn:aws:secretsmanager:us-east-1:123456789012:secret:portfolio-helper/pinecone-XXXXXX"
  COMPOSIO_API_KEY  = "arn:aws:secretsmanager:us-east-1:123456789012:secret:portfolio-helper/composio-XXXXXX"
  DAYTONA_API_KEY   = "arn:aws:secretsmanager:us-east-1:123456789012:secret:portfolio-helper/daytona-XXXXXX"
  SENTRY_DSN        = "arn:aws:secretsmanager:us-east-1:123456789012:secret:portfolio-helper/sentry-XXXXXX"
  JWT_SECRET_KEY    = "arn:aws:secretsmanager:us-east-1:123456789012:secret:portfolio-helper/jwt-XXXXXX"
  SECRET_KEY        = "arn:aws:secretsmanager:us-east-1:123456789012:secret:portfolio-helper/flask-secret-XXXXXX"
  NEXTAUTH_SECRET   = "arn:aws:secretsmanager:us-east-1:123456789012:secret:portfolio-helper/nextauth-XXXXXX"
  STRIPE_SECRET_KEY = "arn:aws:secretsmanager:us-east-1:123456789012:secret:portfolio-helper/stripe-XXXXXX"
  STRIPE_WEBHOOK_SECRET = "arn:aws:secretsmanager:us-east-1:123456789012:secret:portfolio-helper/stripe-webhook-XXXXXX"
}

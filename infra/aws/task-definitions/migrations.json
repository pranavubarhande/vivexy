{
  "family": "PROJECT_PREFIX-migrations",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "EXECUTION_ROLE_ARN",
  "taskRoleArn": "TASK_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "migrations",
      "image": "AGENTS_IMAGE",
      "essential": true,
      "command": ["uv", "run", "alembic", "upgrade", "head"],
      "repositoryCredentials": {
        "credentialsParameter": "GHCR_CREDENTIALS_SECRET_ARN"
      },
      "environment": [{ "name": "FLASK_ENV", "value": "production" }],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "DATABASE_URL_SECRET_ARN" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/PROJECT_PREFIX-migrations",
          "awslogs-region": "AWS_REGION",
          "awslogs-stream-prefix": "migrations",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}

# ---------------------------------------------------------------------------
# Coolify environment template
# ---------------------------------------------------------------------------
# Copy these into the "Environment" tab of your Coolify app. Coolify does
# NOT read this file from disk — it is here as documentation / quick paste.
#
# Replace every <...> placeholder with a real value before deploying.
# ---------------------------------------------------------------------------

# --- Image registry -----------------------------------------------
GHCR_OWNER=<your-github-org-or-user>
IMAGE_TAG=latest

# --- Public URLs (set after you bind a domain in Coolify) ---------
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
NEXTAUTH_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# --- Auth / JWT ---------------------------------------------------
NEXTAUTH_SECRET=<openssl rand -hex 32>
JWT_SECRET=<openssl rand -hex 32>
JWT_SECRET_KEY=<openssl rand -hex 32>
JWT_EXPIRES_IN=7d
SECRET_KEY=<openssl rand -hex 32>

# --- Postgres — Supabase (https://supabase.com/dashboard) ---------
# Use the "Session" pooler (port 5432) for long-lived connections
# (Flask workers). The "Transaction" pooler (6543) is for serverless.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Redis — Upstash (https://console.upstash.com) ----------------
# Use the "TLS" connection string (rediss://).
REDIS_URL=rediss://default:<password>@<region>-<name>.upstash.io:6379
# The Next.js frontend reads host/port/password separately.
REDIS_HOST=<region>-<name>.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=<password>

# --- RabbitMQ — CloudAMQP (https://www.cloudamqp.com) -------------
# "Little Lemur" free tier is enough to start. Copy the AMQP URL (amqps://).
RABBITMQ_URL=amqps://<user>:<password>@<host>.cloudamqp.com/<vhost>

# --- AI provider keys --------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
EXA_API_KEY=
PINECONE_API_KEY=
COMPOSIO_API_KEY=
DAYTONA_API_KEY=
SANDBOX_ENABLED=true

# --- AWS S3 (file uploads) ---------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=us-east-1

# --- Stripe ------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=price_...
NEXT_PUBLIC_STRIPE_PRICE_ID_ENTERPRISE=price_...

# --- Sentry ------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Email — Resend (https://resend.com) ------------------------
# Free tier = 3k emails/month. Create an API key, use "resend" as SMTP_USER.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=<resend-api-key>

# --- Feature flags ----------------------------------------------
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_WEB3FORMS_KEY=

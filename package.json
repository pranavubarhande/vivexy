{
  "name": "portfolio-helper-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/frontend",
    "apps/agents-service",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install && npm run install:apps && npm run setup:agents",
    "install:apps": "npm run install:frontend && npm run install:agents && npm run install:desktop",
    "install:frontend": "cd apps/frontend && npm install",
    "install:agents": "cd apps/agents-service && uv sync",
    "setup:agents": "cd apps/agents-service && uv run playwright install chromium",
    "install:desktop": "cd apps/desktop && npm install",
    "dev": "turbo run dev dev:worker dev:scheduler --parallel",
    "dev:frontend": "turbo dev --filter=portfolio-helper-frontend",
    "dev:agents": "turbo run dev dev:worker dev:scheduler --filter=agents-service --parallel",
    "dev:desktop": "cd apps/desktop && npm run dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "clean": "turbo clean",
    "prepare": "if [ -z \"$VERCEL\" ]; then husky || true; fi",
    "test": "turbo test"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "turbo": "^2.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ],
    "apps/agents-service/**/*.{py}": [
      "cd apps/agents-service && uv run --extra dev black",
      "cd apps/agents-service && uv run --extra dev isort"
    ]
  }
}

{
  "name": "portfolio-helper-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install && npm run install:apps",
    "install:apps": "npm run install:frontend && npm run install:agents",
    "install:frontend": "cd apps/frontend && npm install",
    "install:agents": "cd apps/agents-service && poetry install",
    "dev": "turbo dev --parallel",
    "dev:frontend": "turbo dev --filter=portfolio-helper-frontend",
    "dev:agents": "turbo dev --filter=agents-service",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "pg-generate": "turbo pg-generate",
    "pg-migrate": "turbo pg-migrate",
    "seed-stocks": "turbo seed-stocks",
    "test-stock-agent": "turbo test-stock-agent",
    "clean": "turbo clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "turbo": "^2.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ],
    "apps/agents-service/**/*.{py}": [
      "cd apps/agents-service && poetry run black",
      "cd apps/agents-service && poetry run isort"
    ]
  }
}

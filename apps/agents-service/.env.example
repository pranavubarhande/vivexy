# Flask Configuration
FLASK_ENV=development
PORT=5000

# JWT
JWT_SECRET_KEY=your_jwt_secret_key

SECRET_KEY=your_secret_key

# Database
DATABASE_URL="postgresql://postgres:pranav@localhost:5432/vivexy"

# AI Providers
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
GOOGLE_AI_API_KEY=your_google_ai_key
GROQ_API_KEY=your_groq_key

# Web Search & Crawling
EXA_API_KEY=your_exa_api_key

PINECONE_API_KEY=your_pinecone_key

# Document store (/api/documents). Defaults shown; the index must have dimension 384.
# DOCUMENT_PINECONE_INDEX=rag-index
# DOCUMENT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# DOCUMENT_MAX_FILES_PER_UPLOAD=200
# DOCUMENT_MAX_FILE_MB=100
# DOCUMENT_OCR_LANGUAGES=eng            # Tesseract language packs, e.g. eng+fra

# Redis (used for caching, approvals, client tools, SSE relay)
REDIS_URL=redis://localhost:6379

# AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
AWS_S3_REGION=""

COMPOSIO_API_KEY=""

# RabbitMQ (optional — only needed if you want worker-based chat processing)
export RABBITMQ_URL="amqp://guest:guest@localhost:5672"
export USE_RABBITMQ="false"                             # set to "true" to dispatch chat jobs to workers
# export WORKER_QUEUES="document_jobs"                  # worker consumes only these queues (default: all)
export USE_REDIS_STREAM="false"                         # set to "true" for Redis-based SSE relay (multi-worker)

# Sentry config
SENTRY_DSN=""

SANDBOX_ENABLED=true
DAYTONA_API_KEY=""

# ── Finance / Legal / Compliance Agent Tools ──────────────────────────────────
# All domain tools run inside agents-service — no separate servers needed.

# Legal database (optional — CourtListener works without a key, but rate limits apply)
# Get a token at https://www.courtlistener.com/register/
COURTLISTENER_API_TOKEN=""

# Workflow notifications (optional — set to a Slack/Teams/custom webhook URL)
# Leave blank to skip sending notifications (tools still generate structured output)
WORKFLOW_WEBHOOK_URL=""

# SSO (Google / Microsoft)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"

# Email (Resend) — verification emails
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Vivexy <noreply@vivexy.app>"

# Used to build OAuth redirect URIs and email links
BACKEND_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:3000"

# Stripe billing (team subscriptions). Webhook endpoint: <BACKEND_URL>/stripe/webhook
# Subscribe it to checkout.session.completed, customer.subscription.* and invoice.*
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# Python packages required by domain tools (install via: uv add <package>)
# httpx          — HTTP client              (all external API tools — likely already installed)

{
    "name": "portfolio-helper-desktop",
    "version": "0.1.0",
    "private": true,
    "main": "dist/main.js",
    "scripts": {
        "dev": "concurrently -k \"tsc -w\" \"tsc-alias -w\" \"electronmon .\"",
        "format": "npx prettier --write .",
        "format:check": "npx prettier --check .",
        "build": "tsc && tsc-alias",
        "start": "electron .",
        "package": "electron-builder --mac --win --linux"
    },
    "dependencies": {
        "csv-parse": "^5.6.0",
        "pdf-parse": "^1.1.1",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/pdf-parse": "^1.1.4",
        "concurrently": "^9.2.1",
        "electron": "^33.2.0",
        "electron-builder": "^25.1.8",
        "electronmon": "^2.0.4",
        "tsc-alias": "^1.8.16",
        "typescript": "^5.7.0"
    }
}

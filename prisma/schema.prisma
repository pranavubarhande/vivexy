// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(USER)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownedTeams      Team[]        @relation("TeamOwner")
  teamMemberships TeamMember[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  jobs            Job[]
  chats           Chat[]

  @@map("users")
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  slug        String   @unique
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner       User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  subscriptions Subscription[]
  invites     TeamInvite[]

  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  userId   String
  teamId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@map("team_members")
}

model TeamInvite {
  id        String   @id @default(cuid())
  email     String
  role      TeamRole @default(MEMBER)
  token     String   @unique
  teamId    String
  invitedBy String
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_invites")
}

model Subscription {
  id                    String              @id @default(cuid())
  userId                String?
  teamId                String?
  stripeSubscriptionId  String              @unique
  stripeCustomerId      String?
  status                SubscriptionStatus  @default(INACTIVE)
  plan                  Plan                @default(FREE)
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  team     Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  invoices Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id                String   @id @default(cuid())
  userId            String
  subscriptionId    String?
  stripeInvoiceId   String?  @unique
  amount            Int      // Amount in cents
  currency          String   @default("usd")
  status            String
  invoicePdf        String?
  hostedInvoiceUrl  String?
  createdAt         DateTime @default(now())

  // Relations
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("invoices")
}

model StockDataBlob {
    id        String   @id @default(cuid())
    stockId   String
    blobType  String
    content   String
    asOfLabel String?
    parsedJson Json?
    createdAt DateTime @default(now())

    // Relations
    stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

    @@map("stock_data_blobs")
  }

model StockNews {
  id          String   @id @default(cuid())
  stockId     String
  title       String
  link        String
  publishedAt DateTime?
  source      String?
  createdAt   DateTime @default(now())

  // Relations
  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("stock_news")
}

model Stock {
  id              String   @id @default(cuid())
  symbol          String   @unique
  name            String
  cmp             String?
  pe              String?
  marketCap       String?
  divYldPct       String?
  npQtrCr         String?
  qtrProfitVarPct String?
  salesQtrCr      String?
  qtrSalesVarPct  String?
  rocePct         String?
  link            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  jobStocks       JobStock[]
  dataBlobs       StockDataBlob[]
  news            StockNews[]

  @@map("stocks")
}

model Job {
  id             String   @id @default(cuid())
  userId         String
  name           String
  analysisPrompt String?
  runAtTime      String   @default("01:00")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobStocks JobStock[]

  @@map("jobs")
}

model JobStock {
  id        String   @id @default(cuid())
  jobId     String
  stockId   String
  analysis  Json?
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([jobId, stockId])
  @@map("job_stocks")
}

model StripeEventLog {
  id         String   @id @default(cuid())
  type       String
  rawId      String   @unique
  payload    Json
  createdAt  DateTime @default(now())

  @@map("stripe_event_logs")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  TRIALING
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model LLMModel {
  id          String   @id @default(cuid())
  name        String   @unique
  provider    String   // e.g., "openai", "anthropic"
  modelId     String   // e.g., "gpt-4", "claude-3-sonnet"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  messages Message[]
  lastUsedByChats Chat[]

  @@map("llm_models")
}

model Chat {
  id           String   @id @default(cuid())
  userId       String
  title        String?
  lastModelId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  artifacts Artifact[]
  lastModel LLMModel?  @relation(fields: [lastModelId], references: [id])

  @@map("chats")
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      MessageRole
  content   String
  modelId   String?
  reasoning Json?
  createdAt DateTime @default(now())

  // Relations
  chat      Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  model     LLMModel?  @relation(fields: [modelId], references: [id])
  artifacts Artifact[]

  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ArtifactType {
  MD
  HTML
  JS
  TXT
  JSON
  CSV
}

model Artifact {
  id        String      @id @default(cuid())
  chatId    String
  messageId String?
  title     String?
  type      ArtifactType
  filename  String?
  language  String?
  version   Int         @default(1)
  seq       Int
  content   String
  metadata  Json?
  createdAt DateTime    @default(now())

  // Relations
  chat    Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@map("artifacts")
}

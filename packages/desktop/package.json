{
  "name": "@vivexy/desktop",
  "version": "0.2.0",
  "description": "Electron main-process and preload runtime for Vivexy desktop apps",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranavubarhande/vivexy.git",
    "directory": "packages/desktop"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "default": "./dist/preload.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "preload": [
        "dist/preload.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "electron": ">=33"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "csv-parse": "^5.6.0",
    "pdf-parse": "^1.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/pdf-parse": "^1.1.4",
    "electron": "33.4.11",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
